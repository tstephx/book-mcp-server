# Copy to .env (gitignored) and run via: op run --env-file=.env -- <cmd>
# Secrets are op:// references resolved by 1Password at runtime; never paste literal keys here.

ANTHROPIC_API_KEY="op://Automation/API Credentials - Anthropic/credential"

# Required for semantic search
OPENAI_API_KEY="op://Automation/API Credentials - Open AI/credential"

# Paths and non-secret options
BOOK_DB_PATH=/path/to/library.db
BOOKS_DIR=/path/to/books
# AGENTIC_PIPELINE_DB=
# WATCH_DIR=
# PROCESSED_DIR=
